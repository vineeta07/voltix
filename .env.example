# Copy to .env and fill in. Never commit .env.

# --- database -------------------------------------------------------------
POSTGRES_PASSWORD=change-me
VOLTIX_DATABASE_URL=postgresql+psycopg://voltix:change-me@db:5432/voltix

# --- security -------------------------------------------------------------
VOLTIX_SECRET_KEY=change-me-to-a-long-random-string
VOLTIX_CORS_ORIGINS=http://localhost:3000
VOLTIX_EDGE_KEY=change-me-too

# --- sign-in --------------------------------------------------------------
# Google OAuth client ID (Web). Leave empty to disable Google sign-in.
VOLTIX_GOOGLE_CLIENT_ID=
VOLTIX_ADMIN_EMAILS=
VOLTIX_OPERATOR_EMAILS=
# Development login with a role picker. Keep 0 in production.
VOLTIX_DEV_LOGIN=1

# --- MQTT -----------------------------------------------------------------
VOLTIX_MQTT_HOST=mqtt
VOLTIX_MQTT_PORT=1883
VOLTIX_MQTT_USERNAME=voltix
VOLTIX_MQTT_PASSWORD=change-me
VOLTIX_MQTT_TLS=0

# --- running without hardware ----------------------------------------------
# 1 = built-in simulator. Everything it produces is labelled SIMULATED.
VOLTIX_SIMULATE=1
VOLTIX_SEED_DEMO=1

# --- optional integrations (features hide themselves when unset) -----------
VOLTIX_TELEGRAM_BOT_TOKEN=
VOLTIX_LLM_API_KEY=
VOLTIX_OCPP_PORT=9000
